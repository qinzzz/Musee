# AI Service Configuration
AI_PROVIDER=openai  # Default: openai, claude, or gemini
AI_MODEL_OVERRIDE=gpt-4o  # Optional: Force a specific model version (overrides hardcoded models)
                    # Examples:
                    #   OpenAI: "gpt-4o-mini", "gpt-4o", "gpt-4-turbo"
                    #   Claude: "claude-opus-4-20250514", "claude-sonnet-4-20250514"
                    #   Gemini: "gemini-1.5-pro", "gemini-pro-vision"
                    # Leave empty to use default models
OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Database - Neon PostgreSQL (Required for both dev and production)
NEON_DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# File Upload
MAX_FILE_SIZE_MB=10

# Security
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PhotoRoom API
PHOTOROOM_API_KEY=your_photoroom_api_key_here