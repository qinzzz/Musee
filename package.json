{
  "name": "musee",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "frontend-web",
    "frontend-mobile",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "web:dev": "npm run dev --workspace frontend-web",
    "web:test": "npm run test:run --workspace frontend-web",
    "web:build": "npm run build --workspace frontend-web",
    "mobile:start": "npm run start --workspace frontend-mobile",
    "test": "npm run test:run --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
