# Copy to .env.local and supply values for the build you are running.
# Physical devices need the Mac's LAN URL or a hosted HTTPS API URL.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api
EXPO_PUBLIC_APP_ENV=development

# Optional: set BOTH to enable Google sign-in. OAuth client IDs are public;
# never put a client secret in an EXPO_PUBLIC variable.
# Web client ID must match the backend GOOGLE_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client must be registered for com.yujingtang.musee.dev.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
