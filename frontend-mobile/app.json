{
  "expo": {
    "name": "Musee",
    "slug": "musee",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "musee",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yujingtang.musee.dev",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Musee to select artwork photos from your library.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Musee to photograph artworks.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Musee to select artwork photos from your library.",
          "savePhotosPermission": "Allow Musee to save captured artwork photos to your library.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
