{
  "expo": {
    "name": "Musee",
    "slug": "musee",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "musee",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Musee to select artwork photos from your library.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
